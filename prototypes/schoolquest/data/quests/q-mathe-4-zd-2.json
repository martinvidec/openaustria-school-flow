{
  "id": "quest-mathe-4-zd-2",
  "titel": "Brüche — halbe, viertel, achtel",
  "fach": "mathematik",
  "stufe": 4,
  "kompetenz": "mathe.4.zd.2",
  "requires": [
    "mathe.4.zd.1"
  ],
  "bestehensgrenze": 0.8,
  "aufgaben": [
    {
      "typ": "quiz",
      "frage": "1/2 von 8 Äpfeln = ?",
      "optionen": [
        "2",
        "3",
        "4",
        "6"
      ],
      "loesung": 2
    },
    {
      "typ": "eingabe",
      "frage": "3/4 von 8 = ? (Zahl)",
      "loesung": [
        "6"
      ]
    },
    {
      "typ": "quiz",
      "frage": "Welcher Bruchteil ist größer?",
      "optionen": [
        "1/8",
        "1/4",
        "beide gleich"
      ],
      "loesung": 1
    },
    {
      "typ": "eingabe",
      "frage": "1/2 + 1/4 einer Pizza = wie viele Viertel? (Zahl, z.B. '3')",
      "loesung": [
        "3"
      ]
    }
  ],
  "loesungstexte": [
    "8 ÷ 2 = 4 Äpfel.",
    "3/4 von 8 = 3 × (8÷4) = 3×2 = 6.",
    "1/4 = 2/8 > 1/8 — je kleiner der Nenner, desto größer das Stück.",
    "1/2 = 2/4; 2/4 + 1/4 = 3/4 → 3 Viertel."
  ]
}